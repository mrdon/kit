{
  "name": "kit-poster-renderer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Renders Kit event posters: TSX in a V8 isolate -> validated element tree -> Satori -> PNG. Runs as a child process of the kit binary.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "isolated-vm": "6.2.0",
    "satori": "0.47.1",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
