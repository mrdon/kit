<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .Title }}</title>
<link rel="icon" href="data:,">
<!-- NO meta http-equiv="refresh" here, deliberately: a periodic reload would
     kill the SSE stream mid-question. The client has its own watchdog. -->
<style>{{ .CSS }}</style>
</head>
<body>
<div id="stagewrap"></div>
<div id="fit">
  <div class="gamename" id="gamename">{{ .Heading }}</div>
  <div id="dot"></div>
  <div id="clock"></div>

  <!-- 1. join -->
  <section class="screen on" id="s-join">
    <div class="join">
      <div class="join-left">
        <div class="join-words" id="join-words"><span class="join-word">{{ .Heading }}</span></div>
        <div class="join-url" id="join-url">{{ .JoinHost }}</div>
        <div class="join-count" id="join-count">0 TEAMS IN</div>
        <ol class="join-rules" id="join-rules">
          {{ range .Rules }}<li>{{ . }}</li>{{ end }}
        </ol>
      </div>
      <div class="join-right">
        <div class="join-qr">{{ .QR }}</div>
      </div>
    </div>
    <div class="join-pills" id="join-pills"></div>
  </section>

  <!-- 2. board -->
  <section class="screen" id="s-board">
    <div class="pick-callout" id="pick-callout"></div>
    <div class="board-grid" id="board-grid"></div>
  </section>
  <div id="flip" style="opacity:0"></div>

  <!-- 2a. the wheel that draws who picks first. Shown once, on the way into
       the first board of the night. -->
  <section class="screen" id="s-wheel">
    <div class="wheel-wrap">
      <div class="wheel-title">WHO PICKS FIRST?</div>
      <div class="wheel-stage">
        <div class="wheel-disc" id="wheel-disc"></div>
        <div class="wheel-labels" id="wheel-labels"></div>
        <div class="wheel-hub"></div>
        <div class="wheel-pointer"></div>
      </div>
      <div class="wheel-band" id="wheel-band"></div>
    </div>
  </section>

  <!-- 3. question -->
  <section class="screen" id="s-question">
    <div class="q-wrap">
      <div class="q-text" id="q-text"></div>
      <div class="ring-wrap">
        <svg class="ring" id="ring" width="300" height="300" viewBox="0 0 300 300">
          <circle class="track" cx="150" cy="150" r="130"></circle>
          <circle class="arc" id="ring-arc" cx="150" cy="150" r="130"></circle>
        </svg>
        <div class="countdown" id="countdown"></div>
      </div>
      <div>
        <div class="answered-strip" id="answered-strip"></div>
        <div class="answered-count" id="answered-count"></div>
      </div>
    </div>
  </section>

  <!-- 4/5/6. cards: reveal, betting and scoring are the same furniture, laid
       out as three rows so the answer band and the countdown never sit on top
       of the cards or the team names. -->
  <section class="screen" id="s-cards">
    <div class="cards-screen" id="cards-screen">
      <div class="q-text" id="cards-question"></div>
      <div class="cards" id="cards"></div>
      <div class="answered-count" id="bet-tally" style="display:none"></div>
      <div class="cards-footer" id="cards-footer">
        <div class="ring-wrap">
          <svg class="ring" id="cards-ring" width="300" height="300" viewBox="0 0 300 300">
            <circle class="track" cx="150" cy="150" r="130"></circle>
            <circle class="arc" id="cards-ring-arc" cx="150" cy="150" r="130"></circle>
          </svg>
          <div class="countdown" id="cards-countdown"></div>
        </div>
        <div class="answer-band" id="answer-band"></div>
      </div>
    </div>
    <aside class="rail" id="rail">
      <h2>Standings</h2>
      <div id="rail-rows"></div>
    </aside>
  </section>

  <!-- 9. the final's wager: a category, a clock, and a row of locks. The
       question is deliberately absent, and absent from the frame too. -->
  <section class="screen" id="s-wager">
    <div class="wager-wrap">
      <div>
        <div class="wager-tag">FINAL QUESTION</div>
        <div class="wager-cat" id="wager-cat"></div>
      </div>
      <div class="ring-wrap">
        <svg class="ring" id="wager-ring" width="300" height="300" viewBox="0 0 300 300">
          <circle class="track" cx="150" cy="150" r="130"></circle>
          <circle class="arc" id="wager-ring-arc" cx="150" cy="150" r="130"></circle>
        </svg>
        <div class="countdown" id="wager-countdown"></div>
      </div>
      <div>
        <div class="answered-strip" id="wager-strip"></div>
        <div class="answered-count" id="wager-count"></div>
      </div>
    </div>
  </section>

  <!-- 7. the final beat -->
  <section class="screen" id="s-final">
    <div class="final-beat"><h1>FINAL<br>QUESTION</h1></div>
  </section>

  <!-- 8. podium -->
  <section class="screen" id="s-podium">
    <div class="podium" id="podium"></div>
  </section>

  <!-- The join corner. A sibling of the screens rather than a copy inside
       each one, so there is one QR in the DOM and it survives every screen
       swap. joincorner.js decides which phases it is on for. -->
  <div id="joincorner">
    <div class="jc-label">SCAN TO JOIN</div>
    <div class="jc-qr">{{ .QR }}</div>
    <div class="jc-url">{{ .JoinHost }}</div>
  </div>

  <!-- "BAR FLIES JOINED", four seconds, top centre. A table that joins
       mid-game otherwise arrives with nobody in the room noticing. -->
  <div id="jointoast"></div>

  <section class="screen" id="s-hold">
    <div class="hold"><div><h1>{{ .Title }}</h1><p>Waiting for the host.</p></div></div>
  </section>
</div>
<script>
  window.__KIT_TRIVIA_STREAM__ = "{{ .StreamURL }}";
  window.__KIT_TRIVIA_POLL__ = "{{ .PollURL }}";
  window.__KIT_TRIVIA_GAME__ = "{{ .GameName }}";
  window.__KIT_TRIVIA_VERSION__ = "{{ .Version }}";
  window.__KIT_TRIVIA_VERSION_URL__ = "{{ .VersionURL }}";
</script>
<script>{{ .JS }}</script>
</body>
</html>
