<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ .Venue.Wordmark }} &middot; On Tap</title>
<style>{{ .CSS }}</style>
</head>
<body>
<!-- id="stage", not "fit": a screen still running the pre-reload script looks
     for an element called "fit" to splice into itself and falls back to a full
     reload when it cannot find one. Renaming it is what gets a board already
     on the wall onto this script without someone carrying a keyboard to it. -->
<div id="stage" data-version="{{ .Version }}">
<div class="board">

  <header class="head">
    <div class="brand">
      <img src="{{ .Logo }}" alt="">
      <p class="brand-name">{{ .Venue.Wordmark }}</p>
    </div>
    <div class="head-r">
      <p class="head-tag">On Tap</p>
      <p class="head-clock" id="clock"></p>
    </div>
  </header>

  <div class="body">
    <div class="taps">
      {{- range .Columns }}
      <div class="tapcol">
        {{- range . }}
        <div class="sect">
          <p class="sect-head">{{ .Name }}{{ if .Continued }} <span class="sect-cont">cont.</span>{{ end }}</p>
          {{- range .Taps }}
          <div class="tap">
            <div class="tap-l">
              <p class="tap-meta"><span class="tap-style">{{ .Style }}</span>{{ if .ABV }}<span class="tap-sep">&middot;</span><span class="tap-abv">{{ .ABV }}</span>{{ end }}</p>
              <p class="tap-name" data-fit>{{ .Name }}</p>
            </div>
            <div class="tap-r">
              <p class="tap-price">{{ .Price }}</p>
              {{- with .SizeLabel }}
              <p class="tap-size">{{ . }}</p>
              {{- end }}
            </div>
          </div>
          {{- end }}
        </div>
        {{- end }}
      </div>
      {{- end }}
    </div>

    <div class="rail" id="rail">
      {{- range $i, $p := .Panels }}
      <section class="panel{{ if eq $i 0 }} is-on{{ end }}{{ with $p.PhotoClass }} panel-photo {{ . }}{{ end }}">
        <p class="panel-label">{{ $p.Label }}</p>
        {{- if eq $p.Kind "agenda" }}
        <ul class="ev-list">
          {{- range $p.Events }}
          <li class="ev">
            <p class="ev-when">{{ .When }}<span>{{ .Time }}</span></p>
            <p class="ev-title">{{ .Title }}</p>
            <p class="ev-note">{{ .Note }}</p>
          </li>
          {{- end }}
        </ul>
        {{- else if eq $p.Kind "poster" }}
        {{- with $p.ImageURL }}
        <div class="poster-wrap"><img class="poster" src="{{ . }}" alt="{{ $p.Alt }}"></div>
        {{- end }}
        {{- else }}
        <div class="cta">
          <p class="cta-head">{{ $p.Headline }}</p>
          <p class="cta-body">{{ $p.Body }}</p>
          <p class="cta-contact">{{ range $p.Contact }}<span>{{ . }}</span>{{ end }}</p>
        </div>
        {{- end }}
      </section>
      {{- end }}
      <div class="ticks" id="ticks"></div>
    </div>
  </div>

  <!-- The lockup is chrome, not a rail panel. The board this replaced carried
       the same cue in this corner continuously; a rotating slide would be dark
       three times out of four, and it would cost a slot the anniversary poster
       is using. The tap list is still curated in Untappd and mirrored here, so
       it states a fact as much as it asks for a check-in. -->
  <footer class="foot">
    <div class="foot-notes">{{ range .Venue.Footer }}<span>{{ . }}</span>{{ end }}</div>
    <div class="foot-untappd">
      <img src="{{ .Untappd }}" alt="">
      <p>Check in on <span>Untappd</span></p>
    </div>
  </footer>

</div>
</div>

<script>
(function () {
  var DWELL = 14000;
  var VERSION_POLL = 30000;

  /* Scale the fixed stage to whatever we are being shown on. */
  var stage = document.getElementById('stage');
  function scale() {
    var s = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
    stage.style.transform = 'scale(' + s + ')';
    stage.style.left = ((window.innerWidth - 1920 * s) / 2) + 'px';
    stage.style.top = ((window.innerHeight - 1080 * s) / 2) + 'px';
  }
  window.addEventListener('resize', scale);
  scale();

  /* Two passes, in order, because they solve different problems.

     Height first: the tap list is pulled from Untappd, so the number of beers
     and the way they divide into sections is not ours to choose. Shrink the
     whole list until the longest column fits its box — one size for every row,
     so the columns still read as one list.

     Then width: a single long name should not set the size for all seventeen,
     so anything still too wide for its own column shrinks on its own. */
  var NAME_MAX = 46, NAME_MIN = 22;

  /* The rest of the row, as its share of the beer name at full scale, each
     with the smallest size still readable from the far end of the taproom.

     The name used to be the only thing that scaled, which put a floor under
     the row nothing could get past: shrink it below about 30px and the price
     and pour label beside it were the taller side of the row, so every further
     step cost legibility and won back no height. The pass would bottom out
     still overflowing and .tapcol would quietly clip the rest. Sizes are
     computed here rather than in calc() because the wall panel's browser is
     older than the arithmetic is. */
  var ROW = [
    { prop: '--meta-size',  of: 19 / 46, min: 15 },
    { prop: '--price-size', of: 34 / 46, min: 24 },
    { prop: '--pour-size',  of: 17 / 46, min: 13 },
    { prop: '--row-pad',    of:  9 / 46, min:  5 }
  ];

  function setScale(taps, size) {
    taps.style.setProperty('--name-size', size + 'px');
    for (var i = 0; i < ROW.length; i++) {
      var r = ROW[i];
      taps.style.setProperty(r.prop, Math.max(r.min, Math.round(size * r.of)) + 'px');
    }
  }

  function fitColumnHeight() {
    var taps = document.querySelector('.taps');
    if (!taps) return NAME_MAX;
    var cols = taps.querySelectorAll('.tapcol');
    var size = NAME_MAX;
    /* Exit with the size that is actually applied, not one step past it: the
       width pass below starts from what this returns. */
    for (;;) {
      setScale(taps, size);
      var overflows = false;
      for (var i = 0; i < cols.length; i++) {
        if (cols[i].scrollHeight > cols[i].clientHeight + 1) { overflows = true; break; }
      }
      if (!overflows || size <= NAME_MIN) break;
      size -= 1;
    }
    return size;
  }

  function fitNames() {
    var base = fitColumnHeight();
    var names = document.querySelectorAll('[data-fit]');
    for (var i = 0; i < names.length; i++) {
      var el = names[i], size = base;
      el.style.fontSize = '';
      while (el.scrollWidth > el.clientWidth && size > NAME_MIN) {
        size -= 1;
        el.style.fontSize = size + 'px';
      }
    }
  }
  /* Both passes measure the space the header and footer leave behind, so they
     have to run after the things that set that space have laid out. A face
     still swapping or a graphic still decoding reports a box that is about to
     change size, and the list gets fitted to the wrong one. */
  function refit() {
    fitNames();
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(fitNames); }
    var imgs = stage.querySelectorAll('img');
    for (var i = 0; i < imgs.length; i++) {
      if (!imgs[i].complete) { imgs[i].addEventListener('load', fitNames); }
    }
  }
  window.addEventListener('load', refit);
  refit();

  /* Clock. A frozen clock is how anyone walking past can tell the board
     died -- it is the only liveness signal a wall display has. */
  var clock = document.getElementById('clock');
  function tick() {
    var d = new Date();
    var h = d.getHours(), m = d.getMinutes();
    var ampm = h >= 12 ? 'pm' : 'am';
    h = h % 12; if (h === 0) h = 12;
    clock.textContent = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()] +
      ' ' + h + ':' + (m < 10 ? '0' + m : m) + ' ' + ampm;
  }
  tick();
  setInterval(tick, 20000);

  /* Notice a new board.
     The server syncs from Untappd every minute, but a screen that loaded once
     would keep showing what it booted with. So poll a few bytes and reload
     when the stamp moves.

     A full reload, not an in-place swap of the markup. Swapping avoids a brief
     flash and keeps the panel rotation mid-cycle, and it cost us a board: the
     stamp covers the stylesheet and this script as well as the tap list, and a
     swap updates neither. The taproom TV spent a day painting a freshly
     deployed footer with the CSS it had booted with, which sized the Untappd
     icon at its intrinsic 180px, ate the room the tap columns are measured
     against, and clipped the bottom of the list. A flash every few hours is
     cheaper than a class of bug that only ever appears on the wall. */
  function reloadIfStale() {
    var url = location.pathname.replace(/\/$/, '') + '/version';
    if (!/\/menu\//.test(location.pathname)) {
      url = location.pathname.replace(/\/menu$/, '/menu.version');
    }
    fetch(url, { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.text() : null; })
      .then(function (v) {
        if (v && v !== stage.getAttribute('data-version')) { location.reload(); }
      })
      .catch(function () { /* a failed check must never blank the screen */ });
  }
  setInterval(reloadIfStale, VERSION_POLL);

  /* Rotate the side panel. Set up once: a new board arrives as a reload. */
  var panels = document.querySelectorAll('.panel');
  var ticks = document.getElementById('ticks');
  if (panels.length > 1) {
    for (var j = 0; j < panels.length; j++) {
      var t = document.createElement('div');
      t.className = 'tick';
      t.appendChild(document.createElement('i'));
      ticks.appendChild(t);
    }
    ticks.style.setProperty('--dwell', DWELL + 'ms');

    var at = 0;
    function paintTicks() {
      for (var k = 0; k < ticks.children.length; k++) {
        var c = ticks.children[k];
        c.className = 'tick' + (k < at ? ' done' : '');
      }
      /* Force a reflow so the width transition restarts on the live tick. */
      var live = ticks.children[at];
      void live.offsetWidth;
      live.className = 'tick live';
    }
    paintTicks();

    setInterval(function () {
      panels[at].classList.remove('is-on');
      at = (at + 1) % panels.length;
      panels[at].classList.add('is-on');
      paintTicks();
    }, DWELL);
  }
})();
</script>
</body>
</html>
