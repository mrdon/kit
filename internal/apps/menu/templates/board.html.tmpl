<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ .Venue.Wordmark }} &middot; On Tap</title>
<style>{{ .CSS }}</style>
</head>
<body>
<div id="fit" data-version="{{ .Version }}">
<div class="board">

  <header class="head">
    <div class="brand">
      <img src="{{ .Logo }}" alt="">
      <p class="brand-name">{{ .Venue.Wordmark }}</p>
    </div>
    <div class="head-r">
      <p class="head-tag">On Tap</p>
      <p class="head-clock" id="clock"></p>
    </div>
  </header>

  <div class="body">
    <div class="taps">
      {{- range .Columns }}
      <div class="tapcol">
        {{- range . }}
        <div class="sect">
          <p class="sect-head">{{ .Name }}{{ if .Continued }} <span class="sect-cont">cont.</span>{{ end }}</p>
          {{- range .Taps }}
          <div class="tap">
            <div class="tap-l">
              <p class="tap-meta"><span class="tap-style">{{ .Style }}</span>{{ if .ABV }}<span class="tap-sep">&middot;</span><span class="tap-abv">{{ .ABV }}</span>{{ end }}</p>
              <p class="tap-name" data-fit>{{ .Name }}</p>
            </div>
            <div class="tap-r">
              <p class="tap-price">{{ .Price }}</p>
              {{- with .SizeLabel }}
              <p class="tap-size">{{ . }}</p>
              {{- end }}
            </div>
          </div>
          {{- end }}
        </div>
        {{- end }}
      </div>
      {{- end }}
    </div>

    <div class="rail" id="rail">
      {{- range $i, $p := .Panels }}
      <section class="panel{{ if eq $i 0 }} is-on{{ end }}{{ with $p.PhotoClass }} panel-photo {{ . }}{{ end }}">
        <p class="panel-label">{{ $p.Label }}</p>
        {{- if eq $p.Kind "agenda" }}
        <ul class="ev-list">
          {{- range $p.Events }}
          <li class="ev">
            <p class="ev-when">{{ .When }}<span>{{ .Time }}</span></p>
            <p class="ev-title">{{ .Title }}</p>
            <p class="ev-note">{{ .Note }}</p>
          </li>
          {{- end }}
        </ul>
        {{- else if eq $p.Kind "poster" }}
        {{- with $p.ImageURL }}
        <div class="poster-wrap"><img class="poster" src="{{ . }}" alt="{{ $p.Alt }}"></div>
        {{- end }}
        {{- else }}
        <div class="cta">
          <p class="cta-head">{{ $p.Headline }}</p>
          <p class="cta-body">{{ $p.Body }}</p>
          <p class="cta-contact">{{ range $p.Contact }}<span>{{ . }}</span>{{ end }}</p>
        </div>
        {{- end }}
      </section>
      {{- end }}
      <div class="ticks" id="ticks"></div>
    </div>
  </div>

  <footer class="foot">{{ range .Venue.Footer }}<span>{{ . }}</span>{{ end }}</footer>

</div>
</div>

<script>
(function () {
  var DWELL = 14000;
  var VERSION_POLL = 30000;

  /* Scale the fixed stage to whatever we are being shown on. */
  var fit = document.getElementById('fit');
  function scale() {
    var s = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
    fit.style.transform = 'scale(' + s + ')';
    fit.style.left = ((window.innerWidth - 1920 * s) / 2) + 'px';
    fit.style.top = ((window.innerHeight - 1080 * s) / 2) + 'px';
  }
  window.addEventListener('resize', scale);
  scale();

  /* Two passes, in order, because they solve different problems.

     Height first: the tap list is pulled from Untappd, so the number of beers
     and the way they divide into sections is not ours to choose. Shrink the
     whole list until the longest column fits its box — one size for every row,
     so the columns still read as one list.

     Then width: a single long name should not set the size for all seventeen,
     so anything still too wide for its own column shrinks on its own. */
  var NAME_MAX = 46, NAME_MIN = 24;

  function fitColumnHeight() {
    var taps = document.querySelector('.taps');
    if (!taps) return NAME_MAX;
    var cols = taps.querySelectorAll('.tapcol');
    var size = NAME_MAX;
    for (; size > NAME_MIN; size -= 1) {
      taps.style.setProperty('--name-size', size + 'px');
      var overflows = false;
      for (var i = 0; i < cols.length; i++) {
        if (cols[i].scrollHeight > cols[i].clientHeight + 1) { overflows = true; break; }
      }
      if (!overflows) break;
    }
    return size;
  }

  function fitNames() {
    var base = fitColumnHeight();
    var names = document.querySelectorAll('[data-fit]');
    for (var i = 0; i < names.length; i++) {
      var el = names[i], size = base;
      el.style.fontSize = '';
      while (el.scrollWidth > el.clientWidth && size > NAME_MIN) {
        size -= 1;
        el.style.fontSize = size + 'px';
      }
    }
  }
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(fitNames);
  } else {
    window.addEventListener('load', fitNames);
  }

  /* Clock. A frozen clock is how anyone walking past can tell the board
     died -- it is the only liveness signal a wall display has. */
  var clock = document.getElementById('clock');
  function tick() {
    var d = new Date();
    var h = d.getHours(), m = d.getMinutes();
    var ampm = h >= 12 ? 'pm' : 'am';
    h = h % 12; if (h === 0) h = 12;
    clock.textContent = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()] +
      ' ' + h + ':' + (m < 10 ? '0' + m : m) + ' ' + ampm;
  }
  tick();
  setInterval(tick, 20000);

  /* Notice a new tap list.
     The server syncs from Untappd every minute, but a screen that loaded once
     would keep showing the list it booted with. So poll a few bytes and
     re-fetch the page only when the stamp moves.

     Swap the board's markup rather than reloading: a reload on this hardware
     is a visible white flash and it restarts the panel rotation mid-cycle. */
  var stage = document.getElementById('fit');
  function reloadIfStale() {
    var url = location.pathname.replace(/\/$/, '') + '/version';
    if (!/\/menu\//.test(location.pathname)) {
      url = location.pathname.replace(/\/menu$/, '/menu.version');
    }
    fetch(url, { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.text() : null; })
      .then(function (v) {
        if (!v || v === stage.getAttribute('data-version')) return;
        return fetch(location.href, { cache: 'no-store' })
          .then(function (r) { return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var next = doc.getElementById('fit');
            if (!next) { location.reload(); return; }
            stage.innerHTML = next.innerHTML;
            stage.setAttribute('data-version', next.getAttribute('data-version'));
            /* The new markup has no sized names, no clock and no rotation. */
            fitNames();
            tick();
            startRotation();
          });
      })
      .catch(function () { /* a failed check must never blank the screen */ });
  }
  setInterval(reloadIfStale, VERSION_POLL);

  /* Rotate the side panel. */
  var rotationTimer = null;
  function startRotation() {
  var panels = document.querySelectorAll('.panel');
  var ticks = document.getElementById('ticks');
  if (rotationTimer) { clearInterval(rotationTimer); rotationTimer = null; }
  if (panels.length > 1) {
    ticks.innerHTML = '';
    for (var j = 0; j < panels.length; j++) {
      var t = document.createElement('div');
      t.className = 'tick';
      t.appendChild(document.createElement('i'));
      ticks.appendChild(t);
    }
    ticks.style.setProperty('--dwell', DWELL + 'ms');

    var at = 0;
    function paintTicks() {
      for (var k = 0; k < ticks.children.length; k++) {
        var c = ticks.children[k];
        c.className = 'tick' + (k < at ? ' done' : '');
      }
      /* Force a reflow so the width transition restarts on the live tick. */
      var live = ticks.children[at];
      void live.offsetWidth;
      live.className = 'tick live';
    }
    paintTicks();

    rotationTimer = setInterval(function () {
      panels[at].classList.remove('is-on');
      at = (at + 1) % panels.length;
      panels[at].classList.add('is-on');
      paintTicks();
    }, DWELL);
  }
  }
  startRotation();
})();
</script>
</body>
</html>
